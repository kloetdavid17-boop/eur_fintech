# Copy to server/.env and fill in. Every variable uses the ZZPAY_ prefix (kept from the original
# deployment so the live Render service keeps working). Never commit the real .env.
# Anything left empty means "not configured": the app says so via GET /api/config and returns
# 503 / clear errors instead of pretending to work.

# --- Core ---------------------------------------------------------------
# "development" (non-secure cookie, demo seed on) or "production" (Secure cookie, no auto-seed)
ZZPAY_ENVIRONMENT=development
# REQUIRED. Long random string:  python -c "import secrets; print(secrets.token_hex(32))"
ZZPAY_JWT_SECRET=change-me-to-a-long-random-string
ZZPAY_TOKEN_TTL_HOURS=24
# Auth cookie SameSite: lax (default). Use "none" only if frontend and API are on different sites.
ZZPAY_COOKIE_SAMESITE=lax
# Frontend origin used for Stripe return URLs. Empty = first entry of ZZPAY_CORS_ORIGINS.
ZZPAY_FRONTEND_URL=
# Comma-separated allowed origins (the Vite dev server by default)
ZZPAY_CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
# Full URL wins (e.g. Neon): postgresql://user:pass@host/db?sslmode=require
ZZPAY_POSTGRES_URL=
# ...otherwise the local docker-compose database:
ZZPAY_POSTGRES_HOST=localhost
ZZPAY_POSTGRES_PORT=5434
ZZPAY_POSTGRES_USER=zzpay
ZZPAY_POSTGRES_PASSWORD=zzpay
ZZPAY_POSTGRES_DB=zzpay

# --- AI extraction (OpenAI) -----------------------------------------------------
# Empty = extraction unavailable (uploads return 503 ai_not_configured; file kept for manual entry)
ZZPAY_OPENAI_API_KEY=
ZZPAY_OPENAI_MODEL=gpt-4o-mini
ZZPAY_OPENAI_TIMEOUT_SECONDS=60

# --- Uploads ----------------------------------------------------------------------
ZZPAY_MAX_UPLOAD_MB=10

# --- File storage -----------------------------------------------------------------
# Default: originals stored in the database (tt_receipt_files). Set ALL FOUR of endpoint, bucket,
# access key and secret key to use an S3-compatible bucket instead (private bucket, no public URLs).
ZZPAY_S3_ENDPOINT=
ZZPAY_S3_BUCKET=
ZZPAY_S3_ACCESS_KEY=
ZZPAY_S3_SECRET_KEY=
ZZPAY_S3_REGION=

# --- Email out (SMTP) - "email records to accountant" ----------------------------
# Empty host = not configured (the endpoint returns 503 email_not_configured; nothing is "sent").
# Gmail: USER = full address, PASSWORD = 16-char Google App Password, FROM = same address.
ZZPAY_SMTP_HOST=
ZZPAY_SMTP_PORT=587
ZZPAY_SMTP_USER=
ZZPAY_SMTP_PASSWORD=
ZZPAY_SMTP_FROM=TradeTrack <no-reply@tradetrack.ca>
ZZPAY_SMTP_TLS=true

# --- Inbound email (Mailgun route) - see docs/email-forwarding.md -------------------
# Both must be set for forwarding to be enabled.
ZZPAY_MAILGUN_SIGNING_KEY=
ZZPAY_INBOUND_DOMAIN=
ZZPAY_INBOUND_MAX_AGE_SECONDS=300

# --- Billing (Stripe) - see docs/subscription-model.md --------------------------------
# Secret key + price id both set = real Stripe mode; otherwise labelled DEMO mode (no payments).
ZZPAY_STRIPE_SECRET_KEY=
ZZPAY_STRIPE_PRICE_ID=
ZZPAY_STRIPE_WEBHOOK_SECRET=

# --- Plans (defaults live in app/plans.py) --------------------------------------------
ZZPAY_FREE_MONTHLY_LIMIT=5
ZZPAY_PREMIUM_PRICE_CAD=5.99

# --- Demo data ---------------------------------------------------------------------
# Seeds demo@tradetrack.ca (Premium, 3 labelled SAMPLE Ontario receipts) in development, or when
# true. Leave false in production.
ZZPAY_SEED_DEMO=false
ZZPAY_DEMO_PASSWORD=demo1234

# --- Rate limits (per process, in memory) ----------------------------------------------
ZZPAY_LOGIN_MAX_ATTEMPTS=8
ZZPAY_LOGIN_WINDOW_SECONDS=300
ZZPAY_PROCESS_MAX_PER_MINUTE=20
